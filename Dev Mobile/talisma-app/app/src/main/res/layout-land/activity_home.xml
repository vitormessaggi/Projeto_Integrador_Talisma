<?xml version="1.0" encoding="utf-8"?>
<!--
    Home em paisagem (D20, 6.5): bloco de busca borgonha rolável à esquerda (coluna fixa) e
    "Imóveis em Destaque" com rvDestaques à direita. Mesmos ids do retrato.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HomeActivity">

    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="@dimen/tamanho_logo_barra"
        android:layout_height="@dimen/tamanho_logo_barra"
        android:layout_marginStart="@dimen/margem_tela"
        android:contentDescription="@string/desc_logo"
        app:layout_constraintBottom_toBottomOf="@id/txtMarca"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/txtMarca"
        app:srcCompat="@drawable/ic_marcador_casa" />

    <TextView
        android:id="@+id/txtMarca"
        style="@style/Texto.Marca"
        android:layout_width="0dp"
        android:layout_height="@dimen/altura_minima_toque"
        android:layout_marginStart="@dimen/espaco_8"
        android:layout_marginEnd="@dimen/margem_tela"
        android:gravity="center_vertical"
        android:text="@string/marca_curta"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/imgLogo"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/txtBannerOffline"
        layout="@layout/banner_offline"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtMarca" />

    <ScrollView
        android:id="@+id/scrollConteudo"
        android:layout_width="@dimen/largura_coluna_paisagem"
        android:layout_height="0dp"
        android:background="@color/borgonha"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/vwBordaNavegacao"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtBannerOffline">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/conteudoHome"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/espaco_16">

            <TextView
                android:id="@+id/txtDestaque"
                style="@style/Texto.TituloTela"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/home_destaque"
                android:textColor="@color/branco"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <View
                android:id="@+id/vwCartaoBusca"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/espaco_12"
                android:background="@drawable/fundo_cartao_branco"
                app:layout_constraintBottom_toBottomOf="@id/spcCartaoBusca"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtDestaque" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/tgFinalidade"
                style="@style/Abas"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/espaco_12"
                android:layout_marginTop="@dimen/espaco_12"
                android:layout_marginEnd="@dimen/espaco_12"
                app:checkedButton="@id/btnComprar"
                app:layout_constraintEnd_toEndOf="@id/vwCartaoBusca"
                app:layout_constraintStart_toStartOf="@id/vwCartaoBusca"
                app:layout_constraintTop_toTopOf="@id/vwCartaoBusca">

                <Button
                    android:id="@+id/btnComprar"
                    style="@style/Abas.Botao"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/home_comprar" />

                <Button
                    android:id="@+id/btnAlugar"
                    style="@style/Abas.Botao"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/home_alugar" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:id="@+id/txtRotuloTipo"
                style="@style/Texto.Rotulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_12"
                android:labelFor="@id/spnTipo"
                android:text="@string/home_tipo_imovel"
                app:layout_constraintEnd_toEndOf="@id/tgFinalidade"
                app:layout_constraintStart_toStartOf="@id/tgFinalidade"
                app:layout_constraintTop_toBottomOf="@id/tgFinalidade" />

            <Spinner
                android:id="@+id/spnTipo"
                style="@style/CampoSpinner"
                android:layout_width="0dp"
                android:layout_height="@dimen/altura_campo"
                android:layout_marginTop="@dimen/espaco_4"
                android:entries="@array/opcoes_tipo"
                app:layout_constraintEnd_toEndOf="@id/tgFinalidade"
                app:layout_constraintStart_toStartOf="@id/tgFinalidade"
                app:layout_constraintTop_toBottomOf="@id/txtRotuloTipo" />

            <TextView
                android:id="@+id/txtRotuloCidade"
                style="@style/Texto.Rotulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_12"
                android:labelFor="@id/spnCidade"
                android:text="@string/home_onde_morar"
                app:layout_constraintEnd_toEndOf="@id/tgFinalidade"
                app:layout_constraintStart_toStartOf="@id/tgFinalidade"
                app:layout_constraintTop_toBottomOf="@id/spnTipo" />

            <Spinner
                android:id="@+id/spnCidade"
                style="@style/CampoSpinner"
                android:layout_width="0dp"
                android:layout_height="@dimen/altura_campo"
                android:layout_marginTop="@dimen/espaco_4"
                android:entries="@array/opcoes_provisorias"
                app:layout_constraintEnd_toEndOf="@id/tgFinalidade"
                app:layout_constraintStart_toStartOf="@id/tgFinalidade"
                app:layout_constraintTop_toBottomOf="@id/txtRotuloCidade" />

            <Button
                android:id="@+id/btnBuscar"
                style="@style/Botao.Primario"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_16"
                android:text="@string/home_buscar"
                app:layout_constraintEnd_toEndOf="@id/tgFinalidade"
                app:layout_constraintStart_toStartOf="@id/tgFinalidade"
                app:layout_constraintTop_toBottomOf="@id/spnCidade" />

            <Space
                android:id="@+id/spcCartaoBusca"
                android:layout_width="0dp"
                android:layout_height="@dimen/espaco_12"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnBuscar" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <TextView
        android:id="@+id/txtTituloDestaques"
        style="@style/Texto.TituloSecao"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/espaco_16"
        android:layout_marginTop="@dimen/espaco_12"
        android:text="@string/home_imoveis_destaque"
        app:layout_constraintEnd_toStartOf="@id/txtVerTodos"
        app:layout_constraintStart_toEndOf="@id/scrollConteudo"
        app:layout_constraintTop_toBottomOf="@id/txtBannerOffline" />

    <TextView
        android:id="@+id/txtVerTodos"
        style="@style/Texto.Link"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/altura_minima_toque"
        android:layout_marginEnd="@dimen/espaco_16"
        android:background="?attr/selectableItemBackground"
        android:gravity="center"
        android:text="@string/home_ver_todos"
        app:layout_constraintBottom_toBottomOf="@id/txtTituloDestaques"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/txtTituloDestaques" />

    <!-- Rolagem vertical: em paisagem o cartão de destaque (220dp ou mais com fonte grande) não cabe na altura (T09). -->
    <ScrollView
        android:id="@+id/scrollDestaques"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/espaco_8"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/vwBordaNavegacao"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/scrollConteudo"
        app:layout_constraintTop_toBottomOf="@id/txtTituloDestaques">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDestaques"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:orientation="horizontal"
            android:paddingStart="@dimen/espaco_16"
            android:paddingEnd="@dimen/espaco_16"
            android:paddingBottom="@dimen/espaco_8"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
    </ScrollView>

    <include
        android:id="@+id/estadoTela"
        layout="@layout/estado_tela"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@id/scrollDestaques"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/scrollDestaques"
        app:layout_constraintTop_toTopOf="@id/scrollDestaques" />

    <include layout="@layout/barra_navegacao" />

</androidx.constraintlayout.widget.ConstraintLayout>
