<?xml version="1.0" encoding="utf-8"?>
<!--
    Toolbar borgonha da área do corretor (D33): voltar branco (opcional), título branco e ação "Sair" à direita
    (opcional). Incluída com <include android:id="@+id/barraTopo" layout="@layout/barra_topo_corretor" .../>;
    título, visibilidade do voltar e do Sair definidos em código.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/barraTopo"
    android:layout_width="match_parent"
    android:layout_height="@dimen/altura_barra_topo"
    android:background="@color/borgonha">

    <ImageButton
        android:id="@+id/btnVoltar"
        android:layout_width="@dimen/altura_barra_topo"
        android:layout_height="@dimen/altura_barra_topo"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/desc_voltar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_voltar"
        app:tint="@color/branco" />

    <TextView
        android:id="@+id/txtTituloTela"
        style="@style/Texto.TituloToolbar"
        android:layout_width="0dp"
        android:layout_height="@dimen/altura_barra_topo"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:textColor="@color/branco"
        app:layout_constraintEnd_toStartOf="@id/btnSair"
        app:layout_constraintStart_toEndOf="@id/btnVoltar"
        app:layout_goneMarginStart="@dimen/margem_tela"
        app:layout_goneMarginEnd="@dimen/margem_tela"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="@string/corretor_titulo" />

    <Button
        android:id="@+id/btnSair"
        style="@style/Botao.Texto"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/altura_barra_topo"
        android:layout_marginEnd="@dimen/espaco_8"
        android:text="@string/corretor_sair"
        android:textColor="@color/branco"
        app:icon="@drawable/ic_sair"
        app:iconTint="@color/branco"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
