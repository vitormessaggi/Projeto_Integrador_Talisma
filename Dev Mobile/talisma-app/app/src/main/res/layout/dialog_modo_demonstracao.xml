<?xml version="1.0" encoding="utf-8"?>
<!--
    Diálogo "Modo demonstração" (D26, 6.7), aberto com 5 toques na versão do Perfil: switch do modo simulado,
    switch "Simular sem conexão", URL da API e o aviso "Ao alternar, a sessão e os dados salvos serão limpos".
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/espaco_24"
    android:paddingTop="@dimen/espaco_8"
    android:paddingEnd="@dimen/espaco_24">

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/swModoDemonstracao"
        style="@style/Texto.Corpo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/altura_minima_toque"
        android:text="@string/demo_switch" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/swSimularOffline"
        style="@style/Texto.Corpo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/altura_minima_toque"
        android:text="@string/demo_simular_offline" />

    <TextView
        android:id="@+id/txtUrlApi"
        style="@style/Texto.Legenda"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espaco_8"
        tools:text="API: http://10.0.2.2:8080" />

    <TextView
        android:id="@+id/txtAviso"
        style="@style/Texto.Legenda"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espaco_12"
        android:text="@string/demo_aviso"
        android:textColor="@color/alerta" />

</LinearLayout>
