<?xml version="1.0" encoding="utf-8"?>
<!-- CartaoImovel do corretor (SelecionarImovel, 6.5, D33): foto, título, localização e contagem "4 fotos". -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardImovel"
    style="@style/CartaoImovel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/espaco_12"
    android:clickable="true"
    android:focusable="true">

    <!-- Altura mínima de 112dp; cresce com a fonte do sistema (130%) em vez de sobrepor os textos (T09). -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/altura_cartao_lista">

        <ImageView
            android:id="@+id/imgCapa"
            android:layout_width="@dimen/largura_foto_cartao"
            android:layout_height="0dp"
            android:background="@color/placeholder_foto"
            android:contentDescription="@string/desc_foto_imovel"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/txtTitulo"
            style="@style/Texto.TituloCartao"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espaco_12"
            android:layout_marginTop="@dimen/espaco_12"
            android:layout_marginEnd="@dimen/espaco_12"
            android:ellipsize="end"
            android:maxLines="2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/imgCapa"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Casa na Praia" />

        <TextView
            android:id="@+id/txtLocalizacao"
            style="@style/Texto.Legenda"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espaco_12"
            android:layout_marginEnd="@dimen/espaco_12"
            android:ellipsize="end"
            android:maxLines="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/imgCapa"
            app:layout_constraintTop_toBottomOf="@id/txtTitulo"
            tools:text="São Paulo, Praia Grande" />

        <TextView
            android:id="@+id/txtContagemFotos"
            style="@style/Texto.Rotulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espaco_12"
            android:layout_marginTop="@dimen/espaco_4"
            android:layout_marginEnd="@dimen/espaco_12"
            android:layout_marginBottom="@dimen/espaco_12"
            android:drawablePadding="@dimen/espaco_4"
            app:layout_constraintTop_toBottomOf="@id/txtLocalizacao"
            app:layout_constraintVertical_bias="1"
            android:gravity="center_vertical"
            android:textColor="@color/borgonha"
            app:drawableStartCompat="@drawable/ic_galeria"
            app:drawableTint="@color/borgonha"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/imgCapa"
            tools:text="4 fotos" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
