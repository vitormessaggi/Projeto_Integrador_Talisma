<?xml version="1.0" encoding="utf-8"?>
<!--
    Confirmação da visita (D30, 6.5): ícone check, "Solicitação enviada!" e "Um corretor entrará em contato
    para confirmar a visita."; botões "Ver meus contatos" | "OK" vêm do AlertDialog.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/espaco_24"
    android:paddingTop="@dimen/espaco_24"
    android:paddingEnd="@dimen/espaco_24">

    <ImageView
        android:id="@+id/imgSucesso"
        android:layout_width="@dimen/tamanho_icone_estado"
        android:layout_height="@dimen/tamanho_icone_estado"
        android:contentDescription="@string/desc_icone_sucesso"
        app:srcCompat="@drawable/ic_check"
        app:tint="@color/sucesso" />

    <TextView
        android:id="@+id/txtTituloSucesso"
        style="@style/Texto.TituloSecao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espaco_16"
        android:gravity="center"
        android:text="@string/visita_sucesso_titulo" />

    <TextView
        android:id="@+id/txtTextoSucesso"
        style="@style/Texto.Corpo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espaco_8"
        android:gravity="center"
        android:text="@string/visita_sucesso_texto"
        android:textColor="@color/texto_secundario" />

</LinearLayout>
