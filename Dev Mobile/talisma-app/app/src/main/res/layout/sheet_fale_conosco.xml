<?xml version="1.0" encoding="utf-8"?>
<!--
    Fale com a imobiliária (D38, 6.5): sheet com telefone, e-mail, endereço e horário (recursos/textos/empresa.md)
    e botões Ligar (ACTION_DIAL) e Enviar e-mail (ACTION_SENDTO).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/margem_tela"
    android:paddingTop="@dimen/espaco_8"
    android:paddingEnd="@dimen/margem_tela"
    android:paddingBottom="@dimen/espaco_24">

    <TextView
        android:id="@+id/txtTituloSheet"
        style="@style/Texto.TituloSecao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/fale_titulo" />

    <TextView
        android:id="@+id/txtTelefone"
        style="@style/Texto.Contato"
        android:text="@string/fale_telefone"
        app:drawableStartCompat="@drawable/ic_telefone" />

    <TextView
        android:id="@+id/txtEmailContato"
        style="@style/Texto.Contato"
        android:text="@string/fale_email"
        app:drawableStartCompat="@drawable/ic_email" />

    <TextView
        android:id="@+id/txtEndereco"
        style="@style/Texto.Contato"
        android:text="@string/fale_endereco"
        app:drawableStartCompat="@drawable/ic_localizacao" />

    <TextView
        android:id="@+id/txtHorario"
        style="@style/Texto.Contato"
        android:text="@string/fale_horario"
        app:drawableStartCompat="@drawable/ic_horario" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espaco_24"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnLigar"
            style="@style/Botao.Contorno"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/espaco_8"
            android:layout_weight="1"
            android:paddingStart="@dimen/espaco_8"
            android:paddingEnd="@dimen/espaco_8"
            android:text="@string/fale_ligar" />

        <Button
            android:id="@+id/btnEnviarEmail"
            style="@style/Botao.Primario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espaco_8"
            android:layout_weight="1"
            android:paddingStart="@dimen/espaco_8"
            android:paddingEnd="@dimen/espaco_8"
            android:text="@string/fale_enviar_email" />
    </LinearLayout>

</LinearLayout>
