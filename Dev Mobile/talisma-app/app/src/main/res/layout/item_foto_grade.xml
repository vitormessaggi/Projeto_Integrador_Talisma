<?xml version="1.0" encoding="utf-8"?>
<!-- Foto quadrada da grade de 3 colunas "Fotos atuais" (FotosImovel, 6.5); toque abre a Galeria. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/espaco_4">

    <ImageView
        android:id="@+id/imgMiniatura"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/placeholder_foto"
        android:contentDescription="@string/desc_foto_imovel"
        android:foreground="?attr/selectableItemBackground"
        android:scaleType="centerCrop"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
