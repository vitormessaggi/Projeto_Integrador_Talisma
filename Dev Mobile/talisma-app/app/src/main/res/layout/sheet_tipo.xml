<?xml version="1.0" encoding="utf-8"?>
<!-- Sheet "Tipo" (6.5, D32): Casa, Apartamento, Terreno em RadioGroup, Limpar | Aplicar. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/margem_tela">

    <TextView
        android:id="@+id/txtTituloSheet"
        style="@style/Texto.TituloSecao"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/filtro_tipo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <RadioGroup
        android:id="@+id/rgTipo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espaco_8"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtTituloSheet">

        <RadioButton
            android:id="@+id/rbCasa"
            style="@style/Texto.Corpo"
            android:layout_width="match_parent"
            android:layout_height="@dimen/altura_minima_toque"
            android:text="@string/tipo_casa" />

        <RadioButton
            android:id="@+id/rbApartamento"
            style="@style/Texto.Corpo"
            android:layout_width="match_parent"
            android:layout_height="@dimen/altura_minima_toque"
            android:text="@string/tipo_apartamento" />

        <RadioButton
            android:id="@+id/rbTerreno"
            style="@style/Texto.Corpo"
            android:layout_width="match_parent"
            android:layout_height="@dimen/altura_minima_toque"
            android:text="@string/tipo_terreno" />
    </RadioGroup>

    <Button
        android:id="@+id/btnLimpar"
        style="@style/Botao.Contorno"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espaco_16"
        android:layout_marginEnd="@dimen/espaco_8"
        android:text="@string/filtro_limpar"
        app:layout_constraintEnd_toStartOf="@id/btnAplicar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rgTipo" />

    <Button
        android:id="@+id/btnAplicar"
        style="@style/Botao.Primario"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/espaco_8"
        android:layout_marginTop="@dimen/espaco_16"
        android:text="@string/filtro_aplicar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnLimpar"
        app:layout_constraintTop_toBottomOf="@id/rgTipo" />

</androidx.constraintlayout.widget.ConstraintLayout>
