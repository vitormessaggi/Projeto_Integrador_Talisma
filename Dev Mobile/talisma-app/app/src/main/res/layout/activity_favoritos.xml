<?xml version="1.0" encoding="utf-8"?>
<!--
    Favoritos (protótipo Favoritos, 6.5). T02: topo final (título e subtítulo) e lista provisória;
    a T04 liga rvFavoritos, o desfazer e o estado vazio.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".FavoritosActivity">

    <TextView
        android:id="@+id/txtTitulo"
        style="@style/Texto.TituloTela"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margem_tela"
        android:layout_marginTop="@dimen/espaco_16"
        android:layout_marginEnd="@dimen/margem_tela"
        android:text="@string/favoritos_titulo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtSubtitulo"
        style="@style/Texto.Legenda"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margem_tela"
        android:layout_marginEnd="@dimen/margem_tela"
        android:text="@string/favoritos_subtitulo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtTitulo" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFavoritos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/espaco_16"
        android:clipToPadding="false"
        android:paddingStart="@dimen/margem_tela"
        android:paddingEnd="@dimen/margem_tela"
        android:paddingBottom="@dimen/espaco_16"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toTopOf="@id/vwBordaNavegacao"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtSubtitulo" />

    <TextView
        android:id="@+id/txtProvisorio"
        style="@style/Texto.Legenda"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margem_tela"
        android:layout_marginEnd="@dimen/margem_tela"
        android:gravity="center"
        android:text="@string/provisorio_em_construcao"
        app:layout_constraintBottom_toBottomOf="@id/rvFavoritos"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/rvFavoritos" />

    <include
        android:id="@+id/estadoTela"
        layout="@layout/estado_tela"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/vwBordaNavegacao"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtSubtitulo" />

    <include layout="@layout/barra_navegacao" />

</androidx.constraintlayout.widget.ConstraintLayout>
