<?xml version="1.0" encoding="utf-8"?>
<!-- CartaoDestaque vertical (6.4): 200×220dp, foto 16:10, título, localização e preço; coração no canto da foto. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardImovel"
    style="@style/CartaoDestaque"
    android:layout_width="@dimen/largura_cartao_destaque"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/espaco_12"
    android:clickable="true"
    android:focusable="true">

    <!-- Altura mínima de 220dp; cresce com a fonte do sistema (130%) em vez de sobrepor os textos (T09). -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/altura_cartao_destaque">

        <ImageView
            android:id="@+id/imgCapa"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@color/placeholder_foto"
            android:contentDescription="@string/desc_foto_imovel"
            android:scaleType="centerCrop"
            app:layout_constraintDimensionRatio="16:10"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/btnFavorito"
            android:layout_width="@dimen/altura_minima_toque"
            android:layout_height="@dimen/altura_minima_toque"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/desc_favoritar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_favorito"
            app:tint="@color/branco" />

        <TextView
            android:id="@+id/txtTitulo"
            style="@style/Texto.TituloCartao"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espaco_12"
            android:layout_marginTop="@dimen/espaco_8"
            android:layout_marginEnd="@dimen/espaco_12"
            android:ellipsize="end"
            android:maxLines="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/imgCapa"
            tools:text="Casa na Praia" />

        <TextView
            android:id="@+id/txtLocalizacao"
            style="@style/Texto.Legenda"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espaco_12"
            android:layout_marginEnd="@dimen/espaco_12"
            android:ellipsize="end"
            android:maxLines="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtTitulo"
            tools:text="São Paulo, Praia Grande" />

        <TextView
            android:id="@+id/txtPreco"
            style="@style/Texto.Preco"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espaco_12"
            android:layout_marginTop="@dimen/espaco_4"
            android:layout_marginEnd="@dimen/espaco_12"
            android:layout_marginBottom="@dimen/espaco_8"
            android:ellipsize="end"
            android:maxLines="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtLocalizacao"
            app:layout_constraintVertical_bias="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="R$ 220.000" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
