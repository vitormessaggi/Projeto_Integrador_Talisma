<?xml version="1.0" encoding="utf-8"?>
<!--
    Cabeçalho do CartaoAuth (6.4): ic_marcador_casa 48dp + "Talismã Imóveis" 22sp SemiBold, centralizados.
    Incluído dentro do cartão das telas de autenticação.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cabecalhoAuth"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/imgLogoAuth"
        android:layout_width="@dimen/tamanho_logo_auth"
        android:layout_height="@dimen/tamanho_logo_auth"
        android:contentDescription="@string/desc_logo"
        app:srcCompat="@drawable/ic_marcador_casa" />

    <TextView
        android:id="@+id/txtMarcaAuth"
        style="@style/Texto.MarcaAuth"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espaco_8"
        android:text="@string/app_name" />

</LinearLayout>
